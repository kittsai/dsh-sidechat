{
  "name": "@deepseek-ai/dsh-sidechat-bundle",
  "description": "Installable profile bundle for the DSH Side Chat plugin (host service + browser panel)",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kittsai/dsh-sidechat.git",
    "directory": "packages/bundle/sidechat"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/index.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-client-sidechat": "workspace:^",
    "@deepseek-ai/dsh-sidechat": "workspace:^"
  }
}
